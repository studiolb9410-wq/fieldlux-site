{
  "name": "fieldlux-site",
  "version": "1.0.0",
  "private": true,
  "description": "FieldLux landing page. Static site with prebuilt Tailwind CSS.",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --minify",
    "watch": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --watch",
    "serve": "node scripts/dev-server.mjs",
    "build:embed": "node scripts/build-embed.mjs",
    "dev": "npm run watch",
    "sync:embed-ux": "node scripts/sync-embed-hero-ux.mjs",
    "preview": "python3 scripts/preview-server.py 4173"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3"
  }
}
